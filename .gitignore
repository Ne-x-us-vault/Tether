# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Dev / scratch artifacts (throwaway scripts and analyzer output captures)
/test_picker.dart
/scratch/
/analysis_output.txt
/analysis_output_utf8.txt
/analyze_output.txt
/analyze_output_utf8.txt

# Machine-specific local config (paths differ per machine)
android/local.properties
android/build/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# Android signing keys (never commit)
*.jks
*.keystore
key.properties
android/app/*.pem

# Edge function dependencies & runtime envs
functions/node_modules/
functions/.env
functions/.deno/
*.env
.env.*

# Supabase CLI local state
supabase/.temp/
.supabase/

# AI tool scratch files
.gemini/

# Editor / OS
.vscode/
